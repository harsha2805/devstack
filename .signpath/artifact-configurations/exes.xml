<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "exes": the GitHub artifact uploaded by the
  release workflow's "Upload the exes for signing" step, a zip holding the two
  exes built by build.ps1. Paste this into the SignPath project under
  Artifact configurations, with the slug "exes" (docs/SIGNING.md).
  The workflow passes the version (e.g. 0.2.0), which build.ps1 also writes
  into each exe's product version.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="devstack-app.exe" product-name="devstack" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="devstack.exe" product-name="devstack" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
