<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installer": the GitHub artifact uploaded by
  the release workflow's "Upload the installer for signing" step, a zip holding
  the Inno Setup installer under the fixed name devstack_setup.exe. Paste this
  into the SignPath project under Artifact configurations, with the slug
  "installer" (docs/SIGNING.md).
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="devstack_setup.exe" product-name="devstack" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
